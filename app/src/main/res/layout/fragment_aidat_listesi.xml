<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- İstatistik Kartı -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:elevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aidat İstatistikleri"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Toplam Aidat"
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₺0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2c3e50" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ödenen"
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/tvPaidAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₺0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#27ae60" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bekleyen"
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/tvPendingAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₺0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#f39c12" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gecikme Zammı"
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/tvLateFeeTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="₺0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#e74c3c" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Arama ve Filtreleme Kartı -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arama ve Filtreleme"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="12dp" />

                <!-- Arama Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="İsim, daire no, email ara..."
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="8dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Filtreler -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Durum Filtresi"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerStatusFilter"
                            android:layout_width="match_parent"
                            android:layout_height="45dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gruplama"
                            android:textSize="12sp"
                            android:textColor="#666"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerGroupBy"
                            android:layout_width="match_parent"
                            android:layout_height="45dp" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnClearFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:text="Filtreleri Temizle"
                    android:textSize="12sp"
                    android:backgroundTint="#95a5a6"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Aidat Listesi -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sakin Aidatları"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:padding="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewAdminAidat"
                    android:layout_width="match_parent"
                    android:layout_height="400dp" />

                <!-- Sayfalama -->
                <LinearLayout
                    android:id="@+id/layoutPagination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="#f8f9fa"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnPrevPage"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="◀ Önceki"
                        android:textSize="12sp"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tvPageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sayfa 1/1"
                        android:textSize="12sp"
                        android:textColor="#666"
                        android:padding="8dp" />

                    <Button
                        android:id="@+id/btnNextPage"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Sonraki ▶"
                        android:textSize="12sp"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>