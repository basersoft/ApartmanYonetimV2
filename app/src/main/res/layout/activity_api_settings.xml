<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f4f8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="24dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ API Ayarları"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvCurrentUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mevcut URL: http://baser.org/apartman/api/api_hepsi.php"
                android:textSize="12sp"
                android:textColor="#7f8c8d"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- API Ayarları Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔧 API Yapılandırması"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:layout_marginBottom="16dp" />

            <!-- Ana Sunucu URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐 Ana Sunucu URL *"
                android:textSize="14sp"
                android:textColor="#2c3e50"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://sunucuadiniz.com"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- API Yolu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 API Yolu *"
                android:textSize="14sp"
                android:textColor="#2c3e50"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etApiPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="/api/endpoint.php"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- SQL Anahtarı -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 SQL Anahtarı *"
                android:textSize="14sp"
                android:textColor="#2c3e50"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSqlKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sql_anahtarınız"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Yedek Sunucu URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Yedek Sunucu URL"
                android:textSize="14sp"
                android:textColor="#2c3e50"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBackupUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://yedek-sunucu.com"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Yedek Sunucu Kullan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Switch
                    android:id="@+id/switchUseBackup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yedek Sunucu Kullan"
                    android:textSize="14sp"
                    android:textColor="#2c3e50" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bağlantı Testi Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧪 Bağlantı Testi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bağlantı durumu bekleniyor..."
                android:textSize="14sp"
                android:textColor="#7f8c8d"
                android:gravity="center"
                android:padding="12dp"
                android:background="#f8f9fa"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bağlantıyı Test Et"
                android:textColor="@android:color/white"
                android:background="@drawable/button_save_background"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Butonlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sıfırla"
                android:textColor="#7f8c8d"
                android:background="@drawable/button_cancel_background"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kaydet"
                android:textColor="@android:color/white"
                android:background="@drawable/button_save_background"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
