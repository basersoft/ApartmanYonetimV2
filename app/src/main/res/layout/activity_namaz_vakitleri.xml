<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NamazVakitleriActivity">

    <!-- ANA İÇERİK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#f0f8ff">

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- TOOLBAR - Normal Toolbar (Diğer aktiviteler gibi) -->
        <!-- DEĞİŞTİR: androidx.appcompat.widget.Toolbar -->
        <!-- YAP: com.google.android.material.appbar.MaterialToolbar -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#3498db"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="🕌 Namaz Vakitleri" />



        <!-- navigationIcon satırı YOK - BaseActivity halledecek -->

        <!-- ANA İÇERİK (ScrollView ile) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Durum Göstergesi -->
                <TextView
                    android:id="@+id/tvDurum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚪ Otomatik mod PASİF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/widget_background"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="20dp" />

                <!-- Otomatik Kontrol Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Otomatik Kontrol"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Namaz vakitlerinde otomatik rahatsız etme"
                                android:textSize="16sp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchOtomatik"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true" />

                        </RelativeLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Konum Seçim Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Konum Seçimi"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:id="@+id/layoutKonum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/btnKonumAl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📍 Konumumu Otomatik Bul"
                                android:backgroundTint="@color/primary"
                                android:textColor="@android:color/white"
                                app:icon="@android:drawable/ic_menu_mylocation"
                                app:iconGravity="textStart"
                                app:iconTint="@android:color/white"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="veya"
                                android:textAlignment="center"
                                android:textColor="@android:color/darker_gray"
                                android:layout_marginVertical="8dp" />

                            <Button
                                android:id="@+id/btnManuelSec"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="✏️ Manüel Seçim Yap"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:textColor="@android:color/white"
                                app:icon="@android:drawable/ic_menu_edit"
                                app:iconGravity="textStart"
                                app:iconTint="@android:color/white" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutManuel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="İl"
                                android:textSize="14sp"
                                android:textColor="@android:color/darker_gray"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinnerIl"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/edit_text_background"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="İlçe"
                                android:textSize="14sp"
                                android:textColor="@android:color/darker_gray"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinnerIlce"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/edit_text_background"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Varsayılan: Mersin / Yenişehir"
                                android:textSize="12sp"
                                android:textColor="@android:color/darker_gray"
                                android:gravity="center"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Süre Ayarları Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Süre Ayarları"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Normal Rahatsız Etme Süresi -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rahatsız etme süresi"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/tvSureDegeri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="30 dakika"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginVertical="8dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="5"
                            android:valueTo="120"
                            android:value="30"
                            android:stepSize="5"
                            android:layout_marginBottom="16dp" />

                        <!-- Erken Başlatma Süresi -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Erken başlatma (camiye giriş)"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvErkenSureDegeri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5 dakika önce"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginVertical="8dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderErkenSure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="15"
                            android:value="5"
                            android:stepSize="1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Namaz vaktinden kaç dakika önce rahatsız etme başlasın? (0: tam vaktinde)"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- İzinler Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="İzinler"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btnIzinVer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rahatsız Etme İznini Ver"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@android:color/white"
                            app:icon="@android:drawable/ic_lock_lock"
                            app:iconGravity="textStart"
                            app:iconTint="@android:color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Kaydet Butonu -->
                <Button
                    android:id="@+id/btnKaydet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Ayarları Kaydet"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

                <!-- Vakitleri Göster Butonu -->
                <Button
                    android:id="@+id/btnVakitleriGoster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="📊 Bugünün Vakitlerini Göster"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_day"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

                <!-- Test Butonları -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnTestAc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Test AÇ"
                        android:backgroundTint="@color/primary"
                        android:textColor="@android:color/white"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        app:iconTint="@android:color/white" />

                    <Button
                        android:id="@+id/btnTestKapat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Test KAPAT"
                        android:backgroundTint="@android:color/holo_red_dark"
                        android:textColor="@android:color/white"
                        app:icon="@android:drawable/ic_media_pause"
                        app:iconGravity="textStart"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

                <!-- Alarm Test Butonu -->
                <Button
                    android:id="@+id/btnSimdiTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⏰ Alarmı ŞİMDİ Tetikle (Test)"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@android:color/white"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

            </LinearLayout>

        </ScrollView>

        <!-- ALT MENÜ -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:menu="@menu/bottom_navigation_menu" />

    </LinearLayout>

    <!-- SOL MENÜ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>