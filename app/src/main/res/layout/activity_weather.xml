<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f8f9fa"
    android:padding="16dp">

    <!-- Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌤️ Hava Durumu"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2c3e50"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Açıklama -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Güncel hava durumu bilgileri aşağıda gösterilmektedir. Veriler OpenWeatherMap API'sinden sağlanmaktadır."
        android:textSize="14sp"
        android:textColor="#7f8c8d"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Hava Durumu Widget'ı -->
    <com.baser.apartman.weather.WeatherWidget
        android:id="@+id/weatherWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <!-- Ek Bilgiler Kartı -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Hava Durumu Bilgileri"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Sıcaklık: Mevcut hava sıcaklığı\n• Hissedilen: Hissedilen gerçek sıcaklık\n• Nem: Havadaki nem oranı\n• Rüzgar: Rüzgar hızı\n• Basınç: Atmosfer basıncı"
                android:textSize="14sp"
                android:textColor="#34495e"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>