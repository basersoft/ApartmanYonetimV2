<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Ana içerik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1a2980">

        <!-- Toolbar (Hamburger menu ile) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1a2980"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:navigationIcon="@drawable/ic_menu_white_24dp"
            app:title="HAVA DURUMU"
            app:titleTextColor="@android:color/white" />

        <!-- İçerik - NestedScrollView içinde -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- DAHA KÜÇÜK Şehir ve sıcaklık kartı -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="#ffffff"
                        android:gravity="center">

                        <!-- Şehir ve refresh butonu -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/tvCityTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mersin"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50"
                                android:layout_centerVertical="true" />

                            <ImageButton
                                android:id="@+id/btnRefresh"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?android:attr/selectableItemBackground"
                                android:src="@drawable/ic_refresh_blue_24dp"
                                android:contentDescription="Yenile"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />

                        </RelativeLayout>

                        <!-- Ana sıcaklık - KÜÇÜLTÜLDÜ -->
                        <TextView
                            android:id="@+id/tvTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16°C"
                            android:textSize="60sp"
                            android:textStyle="bold"
                            android:textColor="#3498db"
                            android:layout_marginBottom="6dp" />

                        <!-- Hava durumu açıklaması -->
                        <TextView
                            android:id="@+id/tvWeatherDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HAFİF YAĞMUR"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#7f8c8d"
                            android:layout_marginBottom="12dp" />

                        <!-- Hava durumu ikonu - DAHA KÜÇÜK -->
                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="fitCenter"
                            android:layout_marginBottom="12dp"
                            android:src="@drawable/ic_weather_rain" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Detaylı bilgiler grid'i - YÜKSEKLİK ARTTIRILDI, YAZILAR KÜÇÜLTÜLDÜ -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:padding="4dp">

                    <!-- Minimum Sıcaklık -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_temp_min"
                                android:layout_marginBottom="4dp"
                                android:tint="#e74c3c" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Min"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvTempMin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15.9°C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Maksimum Sıcaklık -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_temp_max"
                                android:layout_marginBottom="4dp"
                                android:tint="#e74c3c" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvTempMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15.9°C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Nem -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_humidity"
                                android:layout_marginBottom="4dp"
                                android:tint="#3498db" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nem"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="73%"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Basınç -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_pressure"
                                android:layout_marginBottom="4dp"
                                android:tint="#9b59b6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Basınç"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1014 hPa"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Gün Doğumu -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_sunrise"
                                android:layout_marginBottom="4dp"
                                android:tint="#f39c12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doğuş"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvSunrise"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:16"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Gün Batımı -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#ffffff">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_sunset"
                                android:layout_marginBottom="4dp"
                                android:tint="#f39c12" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Batiş"
                                android:textSize="11sp"
                                android:textColor="#95a5a6"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvSunset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:17"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </GridLayout>

                <!-- Son güncelleme bilgisi -->
                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Son güncelleme: 12:30 PM"
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView

        android:id="@+id/navigation_view"
        android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/white"
    app:headerLayout="@layout/nav_header"
    app:menu="@menu/navigation_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>