    <gradient
        android:startColor="#FF3F51B5"
        android:centerColor="#FF2196F3"
        android:endColor="#FF03A9F4"
        android:angle="45" />
    <!-- Köşe yuvarlaklığı -->
    <corners android:radius="20dp" />
