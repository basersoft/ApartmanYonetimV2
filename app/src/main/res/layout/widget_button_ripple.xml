<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFF5722"
                android:endColor="#FFE64A19"
                android:angle="45" />
