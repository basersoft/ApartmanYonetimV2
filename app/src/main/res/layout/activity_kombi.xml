<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Ana içerik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="Kombi Kontrol"
            app:navigationIcon="@drawable/ic_menu" />

        <!-- Mevcut ScrollView içeriği -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/background"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                tools:context=".KombiActivity">

                <!-- Başlık ve Ayarlar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="KOMBİ KONTROL"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="start"/>

                    <!-- Ayarlar Butonu -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKombiAyarlar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="⚙"
                        android:textSize="20sp"
                        android:background="@drawable/circle_button_primary"
                        android:textColor="@android:color/white"
                        android:elevation="4dp" />
                </LinearLayout>

                <!-- KOMBİ DURUMU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KOMBİ DURUMU"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvKombiDurumu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KOMBİ KAPALI"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/green"
                        android:gravity="center"/>

                    <!-- KOMBİ AÇ/KAPAT BUTONLARI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <!-- Aç Butonu -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnKombiAc"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="KOMBİYİ AÇ"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:background="@drawable/rounded_green_button"
                            android:textColor="@android:color/white"
                            android:drawableStart="@drawable/ic_power_on"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:elevation="3dp" />

                        <!-- Kapat Butonu -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnKombiKapat"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="KOMBİYİ KAPAT"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:background="@drawable/rounded_red_button"
                            android:textColor="@android:color/white"
                            android:drawableStart="@drawable/ic_power_off"
                            android:drawablePadding="8dp"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:elevation="3dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SICAKLIK ve NEM GÖSTERGELERİ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- SICAKLIK GÖSTERGESİ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SICAKLIK"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <!-- Circular Progress Bar için FrameLayout -->
                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:gravity="center">

                            <!-- Dış Çember -->
                            <View
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:background="@drawable/circle_outline"
                                android:layout_gravity="center"/>

                            <!-- İç Çember (Progress) -->
                            <com.baser.apartman.views.CircularProgressView
                                android:id="@+id/tempProgressBar"
                                android:layout_width="130dp"
                                android:layout_height="130dp"
                                android:layout_gravity="center"
                                app:strokeWidth="12dp"
                                app:progressColor="@color/temp_gradient_start"
                                app:maxProgress="40"
                                app:showLabel="true"/>

                            <!-- Merkezdeki Sıcaklık Değeri -->
                            <TextView
                                android:id="@+id/tvGercekSicaklikCenter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="22°C"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:layout_gravity="center"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GERÇEK SICAKLIK"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- NEM GÖSTERGESİ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NEM"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <!-- Circular Progress Bar için FrameLayout -->
                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:gravity="center">

                            <!-- Dış Çember -->
                            <View
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:background="@drawable/circle_outline"
                                android:layout_gravity="center"/>

                            <!-- İç Çember (Progress) -->
                            <com.baser.apartman.views.CircularProgressView
                                android:id="@+id/humidityProgressBar"
                                android:layout_width="130dp"
                                android:layout_height="130dp"
                                android:layout_gravity="center"
                                app:strokeWidth="12dp"
                                app:progressColor="@color/humidity_gradient_start"
                                app:maxProgress="100"
                                app:showLabel="true"/>

                            <!-- Merkezdeki Nem Değeri -->
                            <TextView
                                android:id="@+id/tvNemCenter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45%"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/humidity_color"
                                android:layout_gravity="center"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NEM ORANI"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- SICAKLIK AYARI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="İSTENEN SICAKLIK"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvIstenenSicaklik"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21°C"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>
                    </LinearLayout>

                    <!-- Circular SeekBar Container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:gravity="center">

                        <!-- Dış Çember -->
                        <View
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_outline_thick"/>

                        <!-- Sıcaklık Değerleri -->
                        <TextView
                            android:id="@+id/tvCircularTempValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21°C"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_gravity="center"/>

                        <!-- Circular SeekBar -->
                        <com.baser.apartman.views.CircularSeekBar
                            android:id="@+id/circularSeekBar"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            app:minValue="10"
                            app:maxValue="30"
                            app:startAngle="120"
                            app:sweepAngle="300"
                            app:progressColor="@color/temp_gradient_end"
                            app:backgroundStrokeColor="@color/background_stroke"/>

                        <!-- Min/Max Değerleri -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10°C"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_gravity="start|bottom"
                            android:layout_marginStart="40dp"
                            android:layout_marginBottom="20dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30°C"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="40dp"
                            android:layout_marginBottom="20dp"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- DİĞER BİLGİLER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- HİSSEDİLEN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HİSSEDİLEN"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvHissedilen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="24°C"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- DIŞ HAVA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="DIŞ HAVA"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>

                            <!-- Detay Butonu -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnDisHavaDetay"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Detay"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:background="@drawable/rounded_outline_button"
                                android:textColor="@color/primary"
                                android:drawableEnd="@drawable/ic_arrow_right"
                                android:drawablePadding="4dp"
                                android:gravity="center"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDisDurum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Parçalı Bulutlu"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Sıcaklık"
                                    android:textSize="10sp"
                                    android:textColor="@color/text_secondary"
                                    android:gravity="center"/>

                                <TextView
                                    android:id="@+id/tvDisSicaklik"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="18°C"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary"
                                    android:gravity="center"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Nem"
                                    android:textSize="10sp"
                                    android:textColor="@color/text_secondary"
                                    android:gravity="center"/>

                                <TextView
                                    android:id="@+id/tvDisNem"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="48%"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/humidity_color"
                                    android:gravity="center"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- YENİLE BUTONU -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnYenile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="VERİLERİ YENİLE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_primary_button"
                    android:textColor="@android:color/white"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:elevation="4dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>