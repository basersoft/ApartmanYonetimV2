<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_margin="8dp">

    <!-- Resim Görünümü -->
    <ImageView
        android:id="@+id/ivResim"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="Duyuru resmi" />

    <TextView
        android:id="@+id/tvBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duyuru Başlığı"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2c3e50" />

    <TextView
        android:id="@+id/tvIcerik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duyuru içeriği burada yer alacak..."
        android:textSize="14sp"
        android:textColor="#34495e"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvTarih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15 Ocak 2024"
        android:textSize="12sp"
        android:textColor="#7f8c8d"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSetSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 Splash'e Ekle"
        android:backgroundTint="#4361ee"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />

</LinearLayout>